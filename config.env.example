# Copy to config.env after setup-gist.sh, or fill manually:
#   cp config.env.example config.env
#
# GIST_ID comes from: gh api gists -q '.[0].id'  or setup-gist.sh
GIST_ID=your_gist_id
RAW_URL=https://gist.githubusercontent.com/YOUR_GITHUB_USER/your_gist_id/raw/flyint.conf
RAW_URL_YAML=https://gist.githubusercontent.com/YOUR_GITHUB_USER/your_gist_id/raw/flyint.yaml
